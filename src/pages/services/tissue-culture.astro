---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Tissue Culture Laboratory - SSRI">
  <Header />
  <PageHero 
    title="Tissue Culture Laboratory" 
    subtitle="Established in 2001 for rapid micropropagation of disease-free, high-purity sugarcane clones and specialty crops."
    category="Services"
  />

  <main class="service-detail-page">
    <div class="container grid-layout">
      <article class="main-content">
        <div class="content-card">
          <span class="badge">Est. 2001 • Meristem Micropropagation</span>
          <h2>Tissue Culture Operations & Commercial Seed Production</h2>
          <p class="lead-p">
            The <strong>Tissue Culture Laboratory</strong> of SSRI was established in 2001 for the rapid multiplication of disease-free, true-to-type seed of newly released sugarcane varieties.
          </p>
          <p>
            Tissue culture involves the aseptic culture of living plant tissues (Meristem) in artificial growth media to develop clean, pathogen-free new plants.
          </p>

          <div class="gallery-inline">
            <div class="img-card">
              <img src="/images/tissue-culture.png" alt="Sugarcane Tissue Culture Plantlets" onerror="this.onerror=null; this.src='/images/tissue-culture.png'" />
              <span>Aseptic Meristem Plantlet Culture</span>
            </div>
            <div class="img-card">
              <img src="/images/T_1-1024x1024.jpg" alt="Tissue Culture Growth Room" onerror="this.onerror=null; this.src='/images/T_1-1024x1024.jpg'" />
              <span>Controlled Environment Growth Room</span>
            </div>
          </div>

          <div class="features-list">
            <h3>Key Research Scope & Applications</h3>
            <ul>
              <li><strong>Rapid Multiplication:</strong> Micropropagation of newly released high-sugar recovery sugarcane clones (SLSG-1653, SLSG-1654, SLSG-128, SLSG-1591).</li>
              <li><strong>Soma-Clonal Improvement:</strong> Utilizing soma-clonal variation for continuous sugarcane plant improvement and stress tolerance.</li>
              <li><strong>Stevia Micropropagation:</strong> Micropropagation protocol development for natural sweetener Stevia plants.</li>
              <li><strong>Ornamental Floriculture:</strong> Tissue culture of high-value ornamental flowers including Gerbera and Lilium.</li>
            </ul>
          </div>
        </div>
      </article>

      <aside class="sidebar">
        <div class="widget">
          <h3>Services Menu</h3>
          <ul>
            <li><a href="/services/soil-and-water">Soil & Water Advisory</a></li>
            <li><a href="/services/biological-control">Bio-Control Laboratories</a></li>
            <li><a href="/services/tricho-card">Trichogramma Rearing</a></li>
            <li><a href="/services/chrysopa-sheets">Chrysopa Lacewing</a></li>
            <li><a href="/services/tissue-culture" class="active">Tissue Culture Lab</a></li>
            <li><a href="/services/other-services">Agronomy & SOF Fertilizer</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .service-detail-page { padding: 60px 0; background: #f8fafc; }
  .grid-layout { display: grid; grid-template-columns: 2.5fr 1fr; gap: 40px; }
  .content-card { background: #ffffff; padding: 40px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
  .badge { background: #dcfce7; color: var(--primary-color); font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 12px; display: inline-block; margin-bottom: 14px; }
  h2 { font-family: var(--font-heading); font-size: 28px; color: #0f172a; margin-bottom: 16px; }
  p { font-size: 16px; color: #475569; line-height: 1.7; margin-bottom: 16px; }
  .lead-p { font-size: 17.5px; color: #1e293b; }

  .gallery-inline { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 24px 0; }
  .img-card { background: #f8fafc; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0; text-align: center; }
  .img-card img { width: 100%; height: 220px; object-fit: cover; }
  .img-card span { font-size: 13px; color: #64748b; padding: 8px; display: block; }

  .features-list { background: #f0fdf4; padding: 24px; border-radius: 10px; border-left: 4px solid var(--primary-color); margin-top: 24px; }
  .features-list h3 { font-family: var(--font-heading); font-size: 20px; color: var(--primary-dark); margin-bottom: 14px; }
  .features-list ul { padding-left: 20px; }
  .features-list li { font-size: 14.5px; color: #334155; margin-bottom: 10px; line-height: 1.5; }

  .widget { background: #ffffff; padding: 24px; border-radius: 10px; border: 1px solid #e2e8f0; }
  .widget h3 { font-family: var(--font-heading); font-size: 18px; color: #0f172a; margin-bottom: 16px; border-bottom: 2px solid var(--primary-color); padding-bottom: 8px; }
  .widget ul { list-style: none; }
  .widget li { margin-bottom: 8px; }
  .widget a { display: block; padding: 8px 12px; border-radius: 6px; font-size: 14px; color: #475569; }
  .widget a.active, .widget a:hover { background: #f0fdf4; color: var(--primary-color); font-weight: 700; }
  @media (max-width: 992px) { .grid-layout { grid-template-columns: 1fr; } .gallery-inline { grid-template-columns: 1fr; } }
</style>
