---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Chrysoperla carnea Laboratory - SSRI">
  <Header />
  <PageHero 
    title="Chrysoperla carnea Laboratory" 
    subtitle="Mass rearing of green lacewing predators for controlling Pyrilla (Pyrilla perpusilla) infestations."
    category="Services"
  />

  <main class="service-detail-page">
    <div class="container grid-layout">
      <article class="main-content">
        <div class="content-card">
          <span class="badge">Biocontrol Unit • Pyrilla Predator</span>
          <h2>Green Lacewing Mass Production</h2>
          <p class="lead-p">
            The objective of mass production of the green lacewing (<em>Chrysoperla carnea</em>) is to control heavy infestations of Pyrilla (<em>Pyrilla perpusilla</em>), which was previously difficult to manage through conventional chemical sprays.
          </p>
          <p>
            <em>Chrysoperla carnea</em> larvae are voracious predators that feed actively on the eggs, nymphs, and adults of Pyrilla, restoring ecological balance in sugarcane fields.
          </p>

          <div class="media-box">
            <img src="/images/crysopa-card-1024x1024.jpg" alt="Chrysoperla carnea rearing cards" onerror="this.onerror=null; this.src='/images/crysopa-card-1024x1024.jpg'" />
            <span class="caption">Chrysoperla carnea rearing cards ready for field release</span>
          </div>
        </div>
      </article>

      <aside class="sidebar">
        <div class="widget">
          <h3>Services Menu</h3>
          <ul>
            <li><a href="/services/soil-and-water">Soil & Water Advisory</a></li>
            <li><a href="/services/biological-control">Bio-Control Laboratories</a></li>
            <li><a href="/services/tricho-card">Trichogramma Rearing</a></li>
            <li><a href="/services/chrysopa-sheets" class="active">Chrysopa Lacewing</a></li>
            <li><a href="/services/tissue-culture">Tissue Culture Lab</a></li>
            <li><a href="/services/other-services">Agronomy & SOF Fertilizer</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .service-detail-page { padding: 60px 0; background: #f8fafc; }
  .grid-layout { display: grid; grid-template-columns: 2.5fr 1fr; gap: 40px; }
  .content-card { background: #ffffff; padding: 40px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
  .badge { background: #dcfce7; color: var(--primary-color); font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 12px; display: inline-block; margin-bottom: 14px; }
  h2 { font-family: var(--font-heading); font-size: 28px; color: #0f172a; margin-bottom: 16px; }
  p { font-size: 16px; color: #475569; line-height: 1.7; margin-bottom: 16px; }
  .lead-p { font-size: 17.5px; color: #1e293b; }
  .media-box { margin-top: 24px; text-align: center; }
  .media-box img { max-width: 100%; height: auto; border-radius: 8px; border: 1px solid #e2e8f0; }
  .caption { font-size: 13px; color: #64748b; margin-top: 8px; display: block; }
  .widget { background: #ffffff; padding: 24px; border-radius: 10px; border: 1px solid #e2e8f0; }
  .widget h3 { font-family: var(--font-heading); font-size: 18px; color: #0f172a; margin-bottom: 16px; border-bottom: 2px solid var(--primary-color); padding-bottom: 8px; }
  .widget ul { list-style: none; }
  .widget li { margin-bottom: 8px; }
  .widget a { display: block; padding: 8px 12px; border-radius: 6px; font-size: 14px; color: #475569; }
  .widget a.active, .widget a:hover { background: #f0fdf4; color: var(--primary-color); font-weight: 700; }
  @media (max-width: 992px) { .grid-layout { grid-template-columns: 1fr; } }
</style>
