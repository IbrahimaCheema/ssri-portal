---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Biological Control Laboratories - SSRI">
  <Header />
  <PageHero 
    title="Biological Control Of Insect Pests" 
    subtitle="Sustainable, eco-friendly biocontrol pest management established in 1995 to protect sugarcane crops without toxic chemicals."
    category="Services"
  />

  <main class="service-detail-page">
    <div class="container grid-layout">
      <article class="main-content">
        <div class="content-card">
          <span class="badge">Est. 1995 • Chemical-Free Protection</span>
          <h2>Integrated Pest Management Overview</h2>
          <p class="lead-p">
            The <strong>Bio-control Laboratories</strong> of SSRI were established in 1995 for the natural, eco-friendly management of major insect pests infesting sugarcane crops across the region.
          </p>
          <p>
            Biological pest control has proven its worth as a sustainable, highly efficient, low-cost, and non-hazardous alternative to synthetic chemical insecticides.
          </p>

          <div class="labs-sub-grid">
            <div class="lab-card">
              <span class="lab-tag">Egg Parasite</span>
              <h3>Trichogramma chilonis Laboratory</h3>
              <p>Mass rearing of <em>Trichogramma chilonis</em> egg parasites distributed on Tricho cards to eradicate sugarcane borer complex (top borer, stem borer, root borer).</p>
              <a href="/services/tricho-card" class="lab-link">Explore Trichogramma Details →</a>
            </div>

            <div class="lab-card">
              <span class="lab-tag">Predator Insect</span>
              <h3>Chrysoperla carnea Laboratory</h3>
              <p>Mass production of green lacewing (<em>Chrysoperla carnea</em>) cards to prey upon eggs and nymphs of Pyrilla (<em>Pyrilla perpusilla</em>).</p>
              <a href="/services/chrysopa-sheets" class="lab-link">Explore Chrysopa Details →</a>
            </div>
          </div>
        </div>
      </article>

      <aside class="sidebar">
        <div class="widget">
          <h3>Services Menu</h3>
          <ul>
            <li><a href="/services/soil-and-water">Soil & Water Advisory</a></li>
            <li><a href="/services/biological-control" class="active">Bio-Control Laboratories</a></li>
            <li><a href="/services/tricho-card">Trichogramma Rearing</a></li>
            <li><a href="/services/chrysopa-sheets">Chrysopa Lacewing</a></li>
            <li><a href="/services/tissue-culture">Tissue Culture Lab</a></li>
            <li><a href="/services/other-services">Agronomy & SOF Fertilizer</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .service-detail-page { padding: 60px 0; background: #f8fafc; }
  .grid-layout { display: grid; grid-template-columns: 2.5fr 1fr; gap: 40px; }
  .content-card { background: #ffffff; padding: 40px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
  .badge { background: #dcfce7; color: var(--primary-color); font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 12px; display: inline-block; margin-bottom: 14px; }
  h2 { font-family: var(--font-heading); font-size: 28px; color: #0f172a; margin-bottom: 16px; }
  p { font-size: 16px; color: #475569; line-height: 1.7; margin-bottom: 16px; }
  .lead-p { font-size: 17.5px; color: #1e293b; }

  .labs-sub-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px; }
  .lab-card { background: #f0fdf4; padding: 24px; border-radius: 10px; border: 1px solid #bbf7d0; }
  .lab-tag { background: var(--primary-color); color: #ffffff; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 10px; display: inline-block; margin-bottom: 10px; }
  .lab-card h3 { font-family: var(--font-heading); font-size: 18px; color: #0f172a; margin-bottom: 10px; }
  .lab-card p { font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 16px; }
  .lab-link { font-size: 13.5px; font-weight: 700; color: var(--primary-color); }

  .widget { background: #ffffff; padding: 24px; border-radius: 10px; border: 1px solid #e2e8f0; }
  .widget h3 { font-family: var(--font-heading); font-size: 18px; color: #0f172a; margin-bottom: 16px; border-bottom: 2px solid var(--primary-color); padding-bottom: 8px; }
  .widget ul { list-style: none; }
  .widget li { margin-bottom: 8px; }
  .widget a { display: block; padding: 8px 12px; border-radius: 6px; font-size: 14px; color: #475569; }
  .widget a.active, .widget a:hover { background: #f0fdf4; color: var(--primary-color); font-weight: 700; }

  @media (max-width: 992px) { .grid-layout { grid-template-columns: 1fr; } .labs-sub-grid { grid-template-columns: 1fr; } }
</style>
